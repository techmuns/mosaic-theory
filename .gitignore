# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets / local env
.env
.env.*
!.env.example

# Local working store — durable state is the committed JSON/CSV snapshots, NOT the binary DB.
*.db
*.db-journal
*.db-wal
*.db-shm

# Everything under data/ is git-ignored — the working DB, the EOD cache, and the LICENSED manual
# CIQ exports (data/manual/ciq/, never committed) — EXCEPT the durable JSONL snapshots, which are
# the committed provenance the scheduled jobs rebuild from.
data/*
!data/snapshots/

# Frontend — generated snapshot mirror (rebuilt by frontend/build.py every deploy; never committed).
# The DERIVED dossier.json is mirrored here for the viewer; raw CIQ in data/manual/ciq stays ignored.
frontend/snapshots/
frontend/dossiers/
node_modules/

# OS
.DS_Store
