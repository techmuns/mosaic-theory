    "SurvivalBlock": {
      "description": "(R2) The survival gate, recorded in full so its runway arithmetic is re-checkable.\n\nA terminal value is worthless if the company never reaches the terminal year, so this is a HARD\nBLOCK on confirming a BUY rather than an input to the ratio \u2014 an asymmetry computed on a company\nthat runs out of money is not a cheap asymmetry, it is a wrong one.",
      "properties": {
        "status": {
          "title": "Status",
          "type": "string"
        },
        "burn": {
          "anyOf": [
            {
              "type": "number"
