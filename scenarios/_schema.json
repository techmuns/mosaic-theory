{
  "$defs": {
    "Fact": {
      "description": "One source-bound input. ``basis`` names WHAT the number is; ``source`` names WHERE it came\nfrom (form + accession + statement line) so the human can verify rather than trust.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "basis",
        "source"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Result": {
      "description": "Filled by the run. ``pass_fail`` records the bar test honestly \u2014 a FAIL is a result.",
      "properties": {
        "per_scenario": {
          "additionalProperties": {
            "$ref": "#/$defs/ScenarioOutcome"
          },
          "title": "Per Scenario",
          "type": "object"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward"
        },
        "risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "ratio_undefined": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio Undefined"
        },
        "bar": {
          "default": 2.0,
          "title": "Bar",
          "type": "number"
        },
        "pass_fail": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "UNDEFINED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Fail"
        }
      },
      "title": "Result",
      "type": "object"
    },
    "ScenarioInput": {
      "description": "One analyst-supplied leg. ``margin`` is a DECIMAL fraction (0.0625 = 6.25%).",
      "properties": {
        "revenue": {
          "title": "Revenue",
          "type": "number"
        },
        "margin": {
          "title": "Margin",
          "type": "number"
        },
        "multiple": {
          "title": "Multiple",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "revenue",
        "margin",
        "multiple",
        "reason"
      ],
      "title": "ScenarioInput",
      "type": "object"
    },
    "ScenarioOutcome": {
      "description": "One computed leg + its capital-intensity cross-checks.",
      "properties": {
        "value_per_share": {
          "title": "Value Per Share",
          "type": "number"
        },
        "op_income": {
          "title": "Op Income",
          "type": "number"
        },
        "ebitda": {
          "title": "Ebitda",
          "type": "number"
        },
        "ev": {
          "title": "Ev",
          "type": "number"
        },
        "equity": {
          "title": "Equity",
          "type": "number"
        },
        "ev_ebit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ev Ebit"
        },
        "norm_fcf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Norm Fcf"
        }
      },
      "required": [
        "value_per_share",
        "op_income",
        "ebitda",
        "ev",
        "equity"
      ],
      "title": "ScenarioOutcome",
      "type": "object"
    },
    "Verdict": {
      "description": "The human's call. The machine NEVER sets anything but ``pending_analyst``.\n\nA verdict that says only \"no\" decays into a number nobody can re-check. ``rationale`` records\nWHY, and ``reunderwrite_triggers`` records what would have to change for the answer to change \u2014\nso a WATCH is a standing instruction rather than a shrug.",
      "properties": {
        "status": {
          "default": "pending_analyst",
          "enum": [
            "pending_analyst",
            "confirmed",
            "overridden",
            "passed",
            "watch"
          ],
          "title": "Status",
          "type": "string"
        },
        "recorded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "reunderwrite_triggers": {
          "items": {
            "type": "string"
          },
          "title": "Reunderwrite Triggers",
          "type": "array"
        },
        "avoid_priced": {
          "default": false,
          "title": "Avoid Priced",
          "type": "boolean"
        },
        "avoid_priced_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avoid Priced Note"
        }
      },
      "title": "Verdict",
      "type": "object"
    }
  },
  "description": "``scenarios/<TICKER>.json`` \u2014 the full versioned underwrite record.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_desc": {
      "title": "Recipe Desc",
      "type": "string"
    },
    "multiple_basis": {
      "title": "Multiple Basis",
      "type": "string"
    },
    "underwrite_date": {
      "title": "Underwrite Date",
      "type": "string"
    },
    "analyst": {
      "title": "Analyst",
      "type": "string"
    },
    "spot": {
      "title": "Spot",
      "type": "number"
    },
    "spot_source": {
      "title": "Spot Source",
      "type": "string"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "object"
    },
    "scenarios": {
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioInput"
      },
      "title": "Scenarios",
      "type": "object"
    },
    "result": {
      "$ref": "#/$defs/Result"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "ticker",
    "recipe_id",
    "recipe_desc",
    "multiple_basis",
    "underwrite_date",
    "analyst",
    "spot",
    "spot_source",
    "facts",
    "scenarios"
  ],
  "title": "ScenarioRecord",
  "type": "object"
}
