#!/usr/bin/env bash
# GATE-THEN-COMMIT. Runs the full offline gate and commits ONLY on exit 0.
#
# WHY THIS EXISTS: three red pushes in one session, each the same shape — the gate ran, gave a
# correct signal, and the commit was chained into the same invocation so it ran regardless. D16
# ("any command whose exit status is consumed by a pipe is not a gate") was cited three times and
# violated three times. A rule that fails three times is a note, not a rule; this makes the
# habitual behaviour correct by construction instead.
#
#   bin/commit -m "message"      # or any git-commit args
#
# AND THE SECOND HOLE, FOUND 2026-08-03 THE SAME WAY: this script verified the WORKING TREE and
# committed the INDEX. On #321 a test fix was edited but never `git add`ed, so the gate ran green
# on the fixed file while the commit captured the stale staged copy — CI then failed on an
# assertion message that existed nowhere in the working tree. The gate gave a correct signal about
# code that was not the code being committed, which is D16's shape one level up.
# THE FIX IS A PRECONDITION, not more discipline: refuse when the tree and the index disagree.
set -euo pipefail
VENV="${VENV:-/Users/work/Documents/GitHub/mosaic-theory/.venv/bin/python}"
cd "$(git rev-parse --show-toplevel)"

# WHAT IS TESTED MUST BE WHAT IS COMMITTED. Unstaged edits to tracked files, or untracked
# non-ignored files, mean the gate is about to certify something the commit will not contain.
unstaged="$(git diff --name-only)"
untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$unstaged$untracked" ]; then
  echo "── REFUSED: the working tree is not what would be committed ──" >&2
  [ -n "$unstaged" ]  && { echo "  unstaged changes:" >&2; echo "$unstaged"  | sed 's/^/    /' >&2; }
  [ -n "$untracked" ] && { echo "  untracked files:"  >&2; echo "$untracked" | sed 's/^/    /' >&2; }
  echo "  The gate tests the TREE and git commits the INDEX; committing now would certify code" >&2
  echo "  the commit does not contain. Run 'git add -A' (or stage deliberately) and re-run." >&2
  exit 1
fi

echo "── ruff ────────────────────────────────────────────"
"$VENV" -m ruff check vinci tests frontend
echo "── mypy --strict (vinci) ───────────────────────────"
"$VENV" -m mypy --strict vinci
echo "── pytest -m 'not network' ─────────────────────────"
# NOT piped. A pipe would consume the exit status and re-create the very defect this file closes.
find . -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
"$VENV" -m pytest -m "not network" -p no:warnings --tb=short -q

echo "── gate green; committing ──────────────────────────"
git commit "$@"
