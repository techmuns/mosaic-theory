#!/usr/bin/env bash
# THEME INTELLIGENCE — the weekly scan on a laptop or server (the equivalent of
# .github/workflows/theme-intelligence-weekly.yml where Actions is not used).
#
#   bin/theme-intelligence-weekly                 # 10-day window ending today, 25-article cap
#   DAYS=7 MAX_ARTICLES=40 bin/theme-intelligence-weekly
#
# It runs the SAME pipeline as `python -m vinci.theme_intelligence scan`. The registry of record is
# data/theme_intelligence/registry.db (git-ignored WAL SQLite, append-only history tables); a dated
# backup is taken BEFORE every run, so a bad run can always be rolled back by hand.
#
# Exit status: 0 SUCCEEDED · 2 PARTIAL (the readout names the source / article that failed) ·
# 1 FAILED or QA did not pass. A failed run still writes its run record and readout — it is never
# reported as a quiet week. Run it by hand: the weekly run is MANUAL by the operator's ruling
# (2026-10-16), as the weekly screen is — it is never put on a timer.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY="${PY:-.venv/bin/python}"
DAYS="${DAYS:-10}"
MAX_ARTICLES="${MAX_ARTICLES:-25}"
LOG="data/theme_intelligence/weekly.log"
mkdir -p data/theme_intelligence

stamp() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
echo "$(stamp) start days=$DAYS max_articles=$MAX_ARTICLES" >> "$LOG"

"$PY" -m vinci.theme_intelligence backup >> "$LOG" 2>&1

set +e
"$PY" -m vinci.theme_intelligence scan --days "$DAYS" --max-articles "$MAX_ARTICLES" 2>&1 \
  | tee -a "$LOG"
code=${PIPESTATUS[0]}
"$PY" -m vinci.theme_intelligence qa --run latest 2>&1 | tee -a "$LOG"
qa=${PIPESTATUS[0]}
# IS IT PRICED? — market context as of today (display only, $0; needs POLYGON_API_KEY). A failure
# is said loudly and never changes the scan's exit status.
"$PY" -m vinci.theme_intelligence market --as-of "$(date -u +%F)" 2>&1 | tee -a "$LOG"
market=${PIPESTATUS[0]}
[ "$market" -eq 0 ] || echo "$(stamp) WARNING market context FAILED (exit $market) — the desk shows the last one computed" | tee -a "$LOG"
set -e

if [ "$qa" -eq 3 ]; then  # nothing broken, research left open: said, never a failure
  echo "$(stamp) WARNING research verification INCOMPLETE — open figures or arguments in the QA above" | tee -a "$LOG"
elif [ "$qa" -ne 0 ]; then
  code=1  # QA FAILED (an integrity check): FAILED, whatever the scan said (a PARTIAL scan exited 2 — U31c)
fi
echo "$(stamp) end scan_exit=$code qa_exit=$qa market_exit=$market" >> "$LOG"
exit "$code"
