+
+def _ask_reason(asked: dict[str, Hit]) -> str:
+    """The Bash prompt's reason: the checkout, each path and what it is, how the command reaches it,
+    and the line the gate will want."""
+    keys = sorted(asked)
+    shown = keys[:10]
+    roots = sorted({asked[k][0] for k in keys})
+
+    def item(key: str) -> str:
+        root, rel, why, how, _ = asked[key]
+        where = "" if len(roots) == 1 else f" (in {root})"
+        reach = ("its inline Python names it beside a write call, so it may write it"
+                 if how == "names" else "it writes it")
+        return f"`{rel}`{where} is {why}; {reach}"
+
+    head = f"This Bash command, in the checkout at {roots[0]}," if len(roots) == 1 else (
+        f"This Bash command, in {len(roots)} checkouts,")
+    if len(keys) == 1:
+        what = f"{head} touches a protected path: {item(keys[0])}."
+        _, rel, _, _, is_dir = asked[keys[0]]
+        line = f"<each file it changes under {rel.rstrip('/')}/>" if is_dir else rel
+    else:
+        what = (f"{head} touches {len(keys)} protected paths (showing {len(shown)} of "
+                f"{len(keys)}): " + "; ".join(item(k) for k in shown) + ".")
+        line = "<each file it changes>"
+    return (f"{what} CLAUDE.md treats a change here as crossing the decision line — confirm it "
+            "is intended. Asked once per file per checkout per session (.claude/hooks/"
+            "decision_path_guard.py). This answer is not the record: the gate refuses the branch "
+            f"until a commit message on it carries `Operator-approved: {line} \"<the operator's "
+            "words>\" <YYYY-MM-DD>` (.github/scripts/protected_approval.py).")
+
+
+# ── W77: reading a Bash command for the files it writes ──────────────────────────────────────────
+
+class Target(NamedTuple):
+    """An absolute path a Bash command writes, and how to match it: ``file`` (that path), ``dir``
+    (a path a script names, which may be a directory it writes into), ``tree`` (a path overwritten
+    whole, so every protected entry below it as well) or ``gone`` (a ``tree`` removed: only what
+    git tracks there counts, since the gate never sees an untracked file go). ``how`` is "writes",
+    or "names" for a path inline Python only names beside a write call."""
+
+    path: str
+    kind: str = "file"
+    how: str = "writes"
+
+
+class _Command(NamedTuple):
+    words: list[str]          # past VAR=value and wrapper words; redirections removed
+    cwd: str | None           # the directory it runs in (None after a `cd` only the shell knows)
+    writes: list[str]         # the words its write redirections name
+    stdin: str | None         # its heredoc or here-string
+    stdin_file: str | None    # the word `<` feeds it from
+
+
+#: A heredoc: `<<` (never `<<<`), an optional `-`, the marker quoted or not, the rest of the
+#: marker's line, the body (whole lines) and the marker's own line.
+_HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)[ \t]*\\?(['\"]?)([A-Za-z_][\w.-]*)\2([^\n]*)\n"
+                      r"((?:[^\n]*\n)*?)[ \t]*\3[ \t]*(?:\n|\Z)")
+_HEREDOC_WORD = re.compile(r"__W77_HEREDOC_(\d+)__")
+_PUNCT = "();<>|&\n"
+#: A shell operator token that redirects, with any separator shlex merged in front of it (`;>`).
+_REDIRECT = re.compile(r"(?P<sep>[;|&\n()]*?)(?P<op>&>>|&>|>>|>\||<>|>&|<&|<<<|<<|>|<)")
+_SAFE_REFS = {"HEAD", "@", "main", "origin/main", "refs/heads/main", "refs/remotes/origin/main"}
+_PYTHON = re.compile(r"python(?:\d+(?:\.\d+)?)?")
+_SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
+_MAX_DEPTH = 3
+_MAX_GLOB = 200
+_MAX_SCRIPT = 1_000_000
+
+
+def _tokens(text: str) -> list[str]:
+    """Shell words and operators; a newline is an operator (it ends a command), a comment is kept
+    as words and dropped by the reader. Raises ValueError on unbalanced quotes."""
+    lexer = shlex.shlex(text, posix=True, punctuation_chars=_PUNCT)
+    lexer.whitespace = " \t\r"
+    lexer.whitespace_split = True
+    lexer.commenters = ""
+    return list(lexer)
+
+
+def _strip(words: list[str]) -> list[str]:
+    """``words`` past VAR=value and the words that only set up how the next one runs (`env -u X`,
+    `timeout 60`, `nice -n 5`, `uv run`, `xargs -0`): the command that runs."""
+    i = 0
+    while i < len(words):
+        word, name = words[i], os.path.basename(words[i])
+        if re.fullmatch(r"[A-Za-z_]\w*=.*", word, re.S):
+            i += 1
+        elif name == "env":
+            i += 1
+            while i < len(words) and (words[i].startswith("-") or "=" in words[i]):
+                i += 2 if words[i] in ("-u", "--unset", "-C", "--chdir", "-S") else 1
+        elif name in ("time", "command", "exec", "builtin", "noglob", "nohup", "caffeinate"):
+            i += 1
+            while i < len(words) and words[i].startswith("-"):
+                i += 1
+        elif name in ("nice", "sudo", "stdbuf", "ionice"):
+            i += 1
+            while i < len(words) and words[i].startswith("-"):
+                i += 2 if words[i] in ("-n", "-u", "-g", "-c") else 1
+        elif name in ("timeout", "gtimeout"):
+            i += 1
+            while i < len(words) and words[i].startswith("-"):
+                i += 2 if words[i] in ("-s", "--signal", "-k", "--kill-after") else 1
+            i += 1                                     # the duration
+        elif name == "xargs":
+            i += 1
+            while i < len(words) and words[i].startswith("-"):
+                i += 2 if words[i] in ("-I", "-n", "-P", "-L", "-d", "-E", "-s", "-J", "-R") else 1
+        elif name in ("uv", "poetry", "pipenv", "pdm") and words[i + 1:i + 2] == ["run"]:
+            i += 2
+            while i < len(words) and words[i].startswith("-"):
+                i += 2 if words[i] in ("--with", "--python", "-p", "--directory", "--project",
+                                       "--extra", "--group", "--env-file") else 1
+        else:
+            break
+    return words[i:]
+
+
+def _resolve_cd(current: str | None, args: list[str]) -> str | None:
+    """Where `cd args` lands from ``current`` — None when only the shell could tell."""
+    operands = [a for a in args if not a.startswith("-") or a == "-"]
+    arg = operands[0] if operands else "~"
+    if current is None or arg == "-" or any(c in arg for c in "$`"):
+        return None
+    path = os.path.expanduser(arg)
+    return os.path.normpath(path if os.path.isabs(path) else os.path.join(current, path))
+
+
+def _commands(text: str, cwd: str | None, dirs: set[str]) -> Iterator[_Command]:
+    """Each simple command the shell text runs, in order, with the directory it runs in, the files
+    its redirections write and the text it reads on stdin. Every directory it runs in is added to
+    ``dirs``. A heredoc's body is DATA, attached to its command; it is never read as commands."""
+    bodies: list[str] = []
+
+    def keep(m: re.Match[str]) -> str:
+        bodies.append(m.group(5))
+        return f" <<__W77_HEREDOC_{len(bodies) - 1}__ {m.group(4)}\n"
+
+    tokens = _tokens(_HEREDOC.sub(keep, text).replace("\\\n", ""))
+    directory = cwd
+    outer: list[str | None] = []                       # the directory each open `(` will restore
+    fallback: str | None = None                        # where `cd X || <this>` runs: before X
+    words: list[str] = []
+    writes: list[str] = []
+    stdin: str | None = None
+    stdin_file: str | None = None
+    comment = False
+    i = 0
+    while i <= len(tokens):
+        token = tokens[i] if i < len(tokens) else ";"
+        punct = bool(token) and all(c in _PUNCT for c in token)
+        redirect = _REDIRECT.fullmatch(token) if punct else None
+        if comment and not (punct and "\n" in token):
+            i += 1
+            continue
+        if punct and (redirect is None or redirect.group("sep")):
+            comment = False
+            if words or writes:
+                command = _strip(words)
+                here = directory if fallback is None else fallback
+                fallback = None
+                if command[:1] == ["cd"]:
+                    if "||" in token:          # the command after `||` runs only if this cd
+                        fallback = here        # FAILED, from where it started (Codex on #1155)
+                    directory = here = _resolve_cd(here, command[1:])
+                if here is not None:
+                    dirs.add(here)
+                yield _Command(command, here, writes, stdin, stdin_file)
+            words, writes, stdin, stdin_file = [], [], None, None
+            for char in token if redirect is None else redirect.group("sep"):
+                if char == "(":                        # a subshell, `$(…)` or `>(…)`: its `cd`
+                    outer.append(directory)            # ends with it (Codex on #1155)
+                elif char == ")" and outer:
+                    directory = outer.pop()
+            if redirect is None:
+                i += 1
+                continue
+        if redirect is not None:
+            op = redirect.group("op")
+            arg = tokens[i + 1] if i + 1 < len(tokens) else ""
+            if op in (">", ">>", ">|", "&>", "&>>", "<>") or (op == ">&" and not (
+                    arg.isdigit() or arg == "-")):
+                writes.append(arg)
+            elif op == "<":
+                stdin_file = arg
+            elif op == "<<<":
+                stdin = arg
+            elif op == "<<":
+                body = _HEREDOC_WORD.fullmatch(arg)
+                stdin = bodies[int(body.group(1))] if body else None
+            i += 2
+            continue
+        if token.startswith("#") and not (words and words[-1].startswith("-")):
+            comment = True                             # (an option's value may start with #)
+        elif not (token.isdigit() and i + 1 < len(tokens) and tokens[i + 1][:1] in "<>&"
+                  and _REDIRECT.fullmatch(tokens[i + 1])):
+            words.append(token)                        # (a descriptor number is not a word)
+        i += 1
+
+
+def _paths(cwd: str | None, word: str, expand: bool = True) -> list[str]:
+    """The absolute path(s) a word names from ``cwd``: a glob is expanded as the shell will (not
+    for a Python string, which nothing globs: ``expand=False``), a word holding `$` or a backtick
+    names nothing this can read."""
+    if not word or any(c in word for c in "$`\n"):
+        return []
+    word = os.path.expanduser(word)
+    if not os.path.isabs(word):
+        if cwd is None:
+            return []
+        word = os.path.join(cwd, word)
+    if expand and any(c in word for c in "*?["):
+        found = sorted(glob.glob(word))[:_MAX_GLOB]
+        if found:
+            return [os.path.normpath(f) for f in found]
+    return [os.path.normpath(word)]
+
+
+def _read(cwd: str | None, word: str | None) -> str | None:
+    """The text of the script file ``word`` names, if it is one this can read."""
+    for path in _paths(cwd, word or "")[:1]:
+        try:
+            if os.path.isfile(path) and os.path.getsize(path) <= _MAX_SCRIPT:
+                return Path(path).read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            return None
+    return None
+
+
+def _operands(args: list[str], valued: Collection[str] = ()) -> list[str]:
+    """The non-option words of ``args``: an option in ``valued`` takes the word after it, and
+    everything after `--` is an operand."""
+    out: list[str] = []
+    skip = False
+    for j, arg in enumerate(args):
+        if skip:
+            skip = False
+        elif arg == "--":
+            return out + args[j + 1:]
+        elif arg in valued:
+            skip = True
+        elif not arg.startswith("-") or arg == "-":
+            out.append(arg)
+    return out
+
+
+def _sed(cmd: _Command, args: list[str]) -> list[Target]:
+    if not any(a == "--in-place" or a.startswith("--in-place=") or (
+            not a.startswith("--") and re.fullmatch(r"-[A-Za-z]*i.*", a, re.S)) for a in args):
+        return []
+    files: list[str] = []
+    script_given = skip = False
+    for arg in args:
+        if skip:
+            skip = False
+        elif arg in ("-e", "-f", "--expression", "--file") or re.fullmatch(r"-[A-Za-z]*[ef]", arg):
+            script_given = skip = True
+        elif arg.startswith(("--expression=", "--file=")):
+            script_given = True
+        elif not arg.startswith("-"):
+            files.append(arg)
+    files = [f for f in files if f]                    # BSD's `-i ''`: the suffix, no file
+    if not script_given:
+        files = files[1:]                              # the first operand is the script
+    return [Target(p) for f in files for p in _paths(cmd.cwd, f)]
+
+
+def _perl(cmd: _Command, args: list[str]) -> list[Target]:
+    if not any(re.fullmatch(r"-[0-9aclnpsTtuUWwX]*i.*", a, re.S) for a in args):
+        return []
+    files: list[str] = []
+    script_given = skip = False
+    for arg in args:
+        if skip:
+            skip = False
+        elif re.fullmatch(r"-[0-9aclnpsTtuUWwXi]*[eE]", arg):
+            script_given = skip = True
+        elif arg in ("-M", "-m", "-I", "-x"):
+            skip = True
+        elif not arg.startswith("-"):
+            files.append(arg)
+    if not script_given:
+        files = files[1:]
+    return [Target(p) for f in files for p in _paths(cmd.cwd, f)]
+
+
+def _files_under(src: str) -> list[str] | None:
+    """The files below an existing directory, relative to it — None when there are too many."""
+    found: list[str] = []
+    for top, _dirs, names in os.walk(src):
+        for name in names:
+            found.append(os.path.relpath(os.path.join(top, name), src))
+            if len(found) > 2000:
+                return None
+    return found
+
+
+def _copy(cmd: _Command, name: str, args: list[str]) -> list[Target]:
+    """`cp`, `mv`, `ln` and `git mv`: the destination(s), and for a move its source."""
+    valued = {"-t", "--target-directory", "-S", "--suffix"}
+    target_dir: str | None = None
+    for j, arg in enumerate(args):
+        if arg in ("-t", "--target-directory") and j + 1 < len(args):
+            target_dir = args[j + 1]
+        elif arg.startswith("--target-directory="):
+            target_dir = arg.split("=", 1)[1]
+    operands = _operands(args, valued)
+    if target_dir is None:
+        if len(operands) < 2:
+            return []
+        target_dir_word, sources = operands[-1], operands[:-1]
+    else:
+        target_dir_word, sources = target_dir, operands
+    named = _paths(cmd.cwd, target_dir_word)
+    dst = named[0] if named else None
+    no_target_dir = "-T" in args or "--no-target-directory" in args
+    into = target_dir is not None or (not no_target_dir and dst is not None and (
+        os.path.isdir(dst) or target_dir_word.endswith("/") or len(sources) > 1))
+    moving = name in ("mv", "git-mv")
+    out: list[Target] = []
+    for word in sources:
+        for src in _paths(cmd.cwd, word):
+            if moving:
+                out.append(Target(src, "gone"))         # the old path changes too
+            if dst is None:
+                continue
+            dest = os.path.normpath(os.path.join(dst, os.path.basename(src))) if into else dst
+            inner = _files_under(src) if os.path.isdir(src) else []
+            if inner is None:                          # too many files to list: the whole tree
+                out.append(Target(dest, "tree"))
+            elif inner:                                # a directory: each file it lands
+                out += [Target(os.path.normpath(os.path.join(dest, f))) for f in inner]
+            else:                                      # a file (or a source not there to read)
+                out.append(Target(dest, "dir"))
+    return out
+
+
+def _patch_paths(text: str) -> list[str]:
+    """The files a `git apply` diff changes, relative to the checkout: its `diff --git a/X b/Y`
+    and `rename from|to` lines, and its `---` / `+++` lines without their `a/` or `b/`."""
+    found: set[str] = set()
+    for line in text.splitlines():
+        m = re.match(r"diff --git a/(\S+) b/(\S+)", line)
+        if m:
+            found |= {m.group(1), m.group(2)}
+        m = re.match(r"rename (?:from|to) (\S+)", line) or re.match(r"(?:\+\+\+|---) [ab]/(\S+)",
+                                                                       line)
+        if m:
+            found.add(m.group(1))
+    return sorted(found)
+
+
+def _git(cmd: _Command, args: list[str], depth: int) -> list[Target]:
+    cwd = cmd.cwd
+    j = 0
+    while j < len(args) and args[j].startswith("-"):
+        if args[j] == "-C" and j + 1 < len(args):
+            cwd = _resolve_cd(cwd, [args[j + 1]])
+            j += 2
+        elif args[j] in ("-c", "--git-dir", "--work-tree", "--namespace"):
+            j += 2
+        else:
+            j += 1
+    if j >= len(args):
+        return []
+    sub, rest = args[j], args[j + 1:]
+    here = cmd._replace(cwd=cwd)
+    if sub == "checkout" and "--" in rest:
+        refs = [a for a in rest[:rest.index("--")] if not a.startswith("-")]
+        if refs and refs[0] not in _SAFE_REFS:
+            return [Target(p, "tree") for w in rest[rest.index("--") + 1:] for p in _paths(cwd, w)]
+        return []
+    if sub == "restore":
+        source = None
+        for k, arg in enumerate(rest):
+            if arg in ("-s", "--source") and k + 1 < len(rest):
+                source = rest[k + 1]
+            elif arg.startswith("--source="):
+                source = arg.split("=", 1)[1]
+        staged_only = any(a in ("-S", "--staged") for a in rest) and not any(
+            a in ("-W", "--worktree") for a in rest)
+        if source is None or source in _SAFE_REFS or staged_only:
+            return []
+        return [Target(p, "tree") for w in _operands(rest, {"-s", "--source"})
+                for p in _paths(cwd, w)]
+    if sub == "mv":
+        return _copy(here, "git-mv", rest)
+    if sub == "rm":
+        return [Target(p, "gone") for w in _operands(rest) for p in _paths(cwd, w)]
+    if sub == "apply" and not any(a in ("--check", "--stat", "--numstat", "--summary")
+                                  for a in rest):
+        root = _checkout_root(cwd) if cwd and os.path.isdir(cwd) else cwd
+        texts = [_read(cwd, w) for w in _operands(rest, {"-p", "--directory", "--exclude",
+                                                         "--include", "-C"}) if w != "-"]
+        if not texts or "-" in rest:
+            texts.append(cmd.stdin if cmd.stdin is not None else _read(cwd, cmd.stdin_file))
+        return [Target(p) for text in texts if text for f in _patch_paths(text)
+                for p in _paths(root, f)]
+    return []
+
+
+
+#: Calls that write, remove or move a file, by the name called (any owner).
+_PY_WRITE_CALLS = {"write", "writelines", "write_text", "write_bytes", "unlink", "touch", "rmdir",
+                   "rmtree", "removedirs", "rename", "renames", "copyfile", "copytree", "symlink",
+                   "symlink_to", "hardlink_to", "truncate", "savefig", "to_csv", "to_json",
+                   "to_parquet", "to_excel", "save"}
+#: Calls that write only with two or more arguments (`shutil.copy(a, b)`, `json.dump(x, fp)`) —
+#: one argument is `dict.copy()` or `yaml.dump(x)`, which return a value.
+_PY_WRITE_CALLS_2 = {"copy", "copy2", "move", "link", "dump"}
+_PY_RUNS = {"run", "call", "check_call", "check_output", "Popen", "system", "getoutput"}
+_PY_WRITE_TEXT = re.compile(
+    r"\.(?:write\w*|unlink|touch|rename|rmdir)\s*\(|\b(?:write\w*|shutil\.\w+|os\.(?:remove|unlink"
+    r"|rename|replace|truncate)|json\.dump|copyfile|copytree)\s*\("
+    r"|\bopen\s*\([^()]*,\s*(?:mode\s*=\s*)?['\"][rbtU]*[wax+][rbtU+]*['\"]")
+_QUOTED = re.compile(r"'([^'\n]*)'|\"([^\"\n]*)\"")
+
+
+def _std_stream(node: ast.expr) -> bool:
+    """Whether ``node`` is `sys.stdout` or `sys.stderr`: a write to one is printing."""
+    return (isinstance(node, ast.Attribute) and node.attr in ("stdout", "stderr")
+            and isinstance(node.value, ast.Name) and node.value.id == "sys")
+
+
+def _python_reads(code: str) -> tuple[list[str], bool, list[str]]:
+    """The string literals ``code`` holds, whether it makes a write call, and the shell commands it
+    runs (`subprocess.run([...])`, `os.system(...)`) — by its syntax tree, or by its text when it
+    does not parse."""
+    try:
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")            # a `\$` in shell-built code warns on stderr
+            tree = ast.parse(code)
+    except (SyntaxError, ValueError):
+        return ([a or b for a, b in _QUOTED.findall(code)], bool(_PY_WRITE_TEXT.search(code)), [])
+    literals: list[str] = []
+    writes = False
+    runs: list[str] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Constant) and isinstance(node.value, str):
+            literals.append(node.value)
+        if not isinstance(node, ast.Call):
+            continue
+        func = node.func
+        name = func.attr if isinstance(func, ast.Attribute) else (
+            func.id if isinstance(func, ast.Name) else "")
+        owner = func.value.id if isinstance(func, ast.Attribute) and isinstance(
+            func.value, ast.Name) else ""
+        args = [*node.args, *(k.value for k in node.keywords)]
+        receiver = func.value if isinstance(func, ast.Attribute) else None
+        if (receiver is not None and (_std_stream(receiver) or (
+                isinstance(receiver, ast.Call) and any(_std_stream(a) for a in receiver.args)))
+                or any(_std_stream(a) for a in args)):
+            pass                                        # sys.stdout.write, csv.writer(sys.stdout)
+        elif name.startswith("write") or name in _PY_WRITE_CALLS or (
+                name in _PY_WRITE_CALLS_2 and len(args) >= 2):
+            writes = True                               # write_record, write_jsonl … included
+        elif name in ("replace", "remove") and (owner == "os" or (
+                name == "replace" and len(node.args) == 1 and not node.keywords)):
+            writes = True                               # os.replace/os.remove, Path.replace(p)
+        elif name == "open" and any(
+                isinstance(a, ast.Constant) and isinstance(a.value, str)
+                and re.fullmatch(r"[rwaxbtU+]{1,4}", a.value) and re.search(r"[wax+]", a.value)
+                for a in args):
+            writes = True
+        if name in _PY_RUNS and node.args:
+            first = node.args[0]
+            if isinstance(first, ast.Constant) and isinstance(first.value, str):
+                runs.append(first.value)
+            elif isinstance(first, (ast.List, ast.Tuple)) and all(
+                    isinstance(e, ast.Constant) and isinstance(e.value, str) for e in first.elts):
+                runs.append(shlex.join(str(e.value) for e in first.elts))  # type: ignore[attr-defined]
+    return literals, writes, runs
+
+
+def _python_targets(code: str, cwd: str | None, depth: int) -> list[Target]:
+    """A protected path the code names, when the code makes a write call — it may write another
+    file, so this asks more than it must; the after-check sees what really changed."""
+    literals, writes, runs = _python_reads(code)
+    out = [t for run in runs for t in _targets(run, cwd, depth + 1)]
+    if writes:
+        out += [Target(p, "dir", "names") for lit in literals if 0 < len(lit) < 300
+                and not lit.startswith("-") for p in _paths(cwd, lit, expand=False)]
+    return out
+
+
+def _python(cmd: _Command, args: list[str], depth: int) -> list[Target]:
+    """Inline code only — `-c CODE`, or a heredoc or here-string on stdin. A script FILE is not
+    read: measured on 34,778 real calls, a repo script such as `frontend/build.py` names
+    `scenarios/` and writes `frontend/` (33 of the first reading's 128 asks), so its writes are the
+    after-check's to see."""
+    code: str | None = None
+    j = 0
+    while j < len(args):
+        arg = args[j]
+        if arg == "-c":
+            code = args[j + 1] if j + 1 < len(args) else ""
+            break
+        if arg == "-m":
+            return []                                  # a module: the after-check's
+        if arg in ("-W", "-X", "-Q"):
+            j += 2
+            continue
+        if arg.startswith("-") and arg != "-":
+            j += 1
+            continue
+        if arg == "-":
+            code = cmd.stdin                           # `python3 - <<'EOF'`
+        break                                          # else a script file: not read
+    else:
+        code = cmd.stdin                               # `python3 <<'EOF'`
+    return _python_targets(code, cmd.cwd, depth) if code else []
+
+
+def _shell(cmd: _Command, args: list[str], depth: int) -> list[Target]:
+    j = 0
+    while j < len(args):
+        arg = args[j]
+        if re.fullmatch(r"-[A-Za-z]*c", arg):
+            return _targets(args[j + 1], cmd.cwd, depth + 1) if j + 1 < len(args) else []
+        if arg in ("-o", "+o"):
+            j += 2
+            continue
+        if arg.startswith(("-", "+")):
+            j += 1
+            continue
+        return _targets(_read(cmd.cwd, arg) or "", cmd.cwd, depth + 1)
+    text = cmd.stdin if cmd.stdin is not None else _read(cmd.cwd, cmd.stdin_file)
+    return _targets(text or "", cmd.cwd, depth + 1)
+
+
+def _command_targets(cmd: _Command, depth: int) -> list[Target]:
+    out = [Target(p) for w in cmd.writes for p in _paths(cmd.cwd, w)]
+    if not cmd.words:
+        return out
+    name, args = os.path.basename(cmd.words[0]), cmd.words[1:]
+    if name == "tee":
+        out += [Target(p) for w in _operands(args) for p in _paths(cmd.cwd, w)]
+    elif name in ("sed", "gsed"):
+        out += _sed(cmd, args)
+    elif name == "perl":
+        out += _perl(cmd, args)
+    elif name in ("cp", "mv", "ln", "gcp", "gmv"):
+        out += _copy(cmd, name.lstrip("g") if name in ("gcp", "gmv") else name, args)
+    elif name in ("rm", "unlink", "grm"):
+        out += [Target(p, "gone") for w in _operands(args) for p in _paths(cmd.cwd, w)]
+    elif name == "touch":
+        out += [Target(p) for w in _operands(args, {"-t", "-d", "-r", "-A", "--date",
+                                                    "--reference"})
+                for p in _paths(cmd.cwd, w) if not os.path.lexists(p)]
+    elif name == "git":
+        out += _git(cmd, args, depth)
+    elif _PYTHON.fullmatch(name):
+        out += _python(cmd, args, depth)
+    elif name in _SHELLS:
+        out += _shell(cmd, args, depth)
+    elif name in ("source", ".") and args:
+        out += _targets(_read(cmd.cwd, args[0]) or "", cmd.cwd, depth + 1)
+    elif name == "eval":
+        out += _targets(" ".join(args), cmd.cwd, depth + 1)
+    elif name == "find":
+        for j, arg in enumerate(args):
+            if arg in ("-exec", "-execdir", "-ok", "-okdir"):
+                sub = []
+                for word in args[j + 1:]:
+                    if word in (";", "+"):
+                        break
+                    sub.append(word)
+                out += _command_targets(_Command(_strip(sub), cmd.cwd, [], None, None), depth + 1)
+    return out
+
+
+def _targets(text: str, cwd: str | None, depth: int = 0, dirs: set[str] | None = None,
+             ) -> list[Target]:
+    if depth > _MAX_DEPTH or not text:
+        return []
+    out: list[Target] = []
+    for cmd in _commands(text, cwd, dirs if dirs is not None else set()):
+        out += _command_targets(cmd, depth)
+    return out
+
+
+def bash_writes(command: str, cwd: str) -> tuple[list[Target], set[str]]:
+    """The paths the Bash command visibly writes, and every directory it runs in. A command whose
+    quotes do not balance names nothing this can read (the after-check still runs)."""
+    dirs: set[str] = {cwd}
+    try:
+        return _targets(command, cwd, 0, dirs), dirs
+    except ValueError:
+        return [], dirs
+
+
+def _tracked(root: str, rel: str) -> bool:
+    """Whether git tracks ``rel`` (or anything below it) in ``root`` — True when git cannot say."""
+    listed = _git_out(Path(root), "ls-files", "-z", "--", rel)
+    return listed is None or bool(listed)
+
+
+def protected_hits(target: Target,
+                   where: Callable[[str], tuple[str, str] | None] = locate,
+                   tracked: Callable[[str, str], bool] = _tracked,
+                   ) -> list[tuple[str, str, str]]:
+    """``(checkout, path relative to it, what it is)`` for each protected path the target writes."""
+    found = where(target.path)
+    if found is None:
+        return []
+    root, rel = found
+    rel = "" if rel in (".", "") else rel.rstrip("/")
+    hits: list[tuple[str, str]] = []
+    why = protected_reason(rel) if rel else None
+    if why:
+        hits = [(rel, why)]
+    elif target.kind != "file" and rel and (why := protected_reason(rel + "/")):
+        hits = [(rel + "/", why)]
+    elif target.kind in ("tree", "gone"):
+        hits = [(path, why) for path, why in PROTECTED if not rel or path.startswith(rel + "/")]
+    if target.kind == "gone":
+        hits = [(r, w) for r, w in hits if tracked(root, r)]
+    return [(root, r, w) for r, w in hits]
+
+
+# ── W77: what a Bash call changed ────────────────────────────────────────────────────────────────
+
+def _content(path: Path) -> str:
+    try:
+        if path.is_symlink():
+            return "link:" + os.readlink(path)
+        return "sha1:" + hashlib.sha1(path.read_bytes()).hexdigest()
+    except FileNotFoundError:
+        return "deleted"
+    except OSError as exc:
+        return f"unreadable:{exc.errno}"
+
+
+#: Every git call of the after-check (A's review of #1155): `--no-optional-locks`, since `git
+#: status` otherwise takes the index lock to refresh it (29 of 150 concurrent `git add` calls then
+#: failed on `index.lock`; 0 with it), and `core.fsmonitor` off, since a configured monitor made
+#: each status run into the 10 s timeout, which left the after-check dead.
+_GIT = ("git", "-c", "core.fsmonitor=false", "--no-optional-locks")
+
+
+def fingerprint(root: Path) -> dict[str, str] | None:
+    """Each protected file that differs from HEAD in ``root`` (modified, deleted or new), by its
+    content; a protected file absent from the map is HEAD's. None when git cannot say."""
+    try:
+        out = subprocess.run([*_GIT, "-C", str(root), "status", "--porcelain=v1", "-z",
+                              "--untracked-files=all", "--no-renames", "--ignore-submodules"],
+                             capture_output=True, stdin=subprocess.DEVNULL, timeout=10)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if out.returncode != 0:
+        return None
+    prints: dict[str, str] = {}
+    for entry in out.stdout.decode("utf-8", "surrogateescape").split("\0"):
+        rel = entry[3:]
+        if len(entry) > 3 and protected_reason(rel) is not None:
+            prints[rel] = _content(root / rel)
+    return prints
+
+
+def _git_out(root: Path, *args: str, stdin: str | None = None) -> str | None:
+    try:
+        if stdin is None:
+            out = subprocess.run([*_GIT, "-C", str(root), *args], stdin=subprocess.DEVNULL,
+                                 capture_output=True, text=True, timeout=10)
+        else:
+            out = subprocess.run([*_GIT, "-C", str(root), *args], input=stdin,
+                                 capture_output=True, text=True, timeout=10)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    return out.stdout if out.returncode == 0 else None
+
+
+def known_states(root: Path, rels: list[str], after: dict[str, str]) -> set[str]:
+    """The ``rels`` whose content after the call is one the gate already holds: HEAD's (a discard,
+    a commit), origin/main's or main's (a re-sync), or that of the commit a merge, rebase or
+    cherry-pick is applying — none of them a change an agent made unasked."""
+    known = {r for r in rels if r not in after}
+    present = [r for r in rels if r in after and after[r].startswith("sha1:")]
+    deleted = [r for r in rels if after.get(r) == "deleted"]
+    hashes = (_git_out(root, "hash-object", "--stdin-paths", stdin="\n".join(present) + "\n")
+              or "").split()
+    blobs = {r: hashes[k] for k, r in enumerate(present) if k < len(hashes)}
+    for ref in ("HEAD", "origin/main", "main", "MERGE_HEAD", "REBASE_HEAD",
+                "CHERRY_PICK_HEAD"):
+        if not (present or deleted) or _git_out(root, "rev-parse", "--verify", "--quiet",
+                                                f"{ref}^{{commit}}") is None:
+            continue
+        listing = _git_out(root, "ls-tree", "-r", "-z", ref, "--", *present, *deleted)
+        if listing is None:
+            continue
+        tree = {e.split("\t", 1)[1]: e.split()[2] for e in listing.split("\0") if "\t" in e}
+        known |= {r for r in present if blobs.get(r) and tree.get(r) == blobs[r]}
+        known |= {r for r in deleted if r not in tree}
+    return known
+
+
+def _pending_file(session: str, call: str) -> Path:
+    safe = "".join(c for c in call if c.isalnum() or c in "-_") or "unknown"
+    return _state_file(session, f"-call-{safe}")
+
+
+def _roots(dirs: set[str]) -> list[Path]:
+    """The mosaic checkouts the directories are in (at most 8)."""
+    roots: list[Path] = []
+    for directory in sorted(dirs)[:40]:
+        probe = Path(directory)
+        while not probe.exists() and probe != probe.parent:
+            probe = probe.parent
+        root = _checkout_root(str(probe))
+        if root is not None and Path(root) not in roots:
+            roots.append(Path(root))
+    return roots[:8]
+
+
+def _prune(session: str) -> None:
+    """Remove this session's per-call readings older than a day: a denied ask leaves one, since no
+    PostToolUse follows it."""
+    for stale in STATE_DIR.glob(_state_file(session, "-call-*").name):
+        try:
+            if time.time() - stale.stat().st_mtime > 86400:
+                stale.unlink()
+        except OSError:
+            pass
+
+
+def _bash_before(command: str, cwd: str, session: str, call: str) -> int:
+    targets, dirs = bash_writes(command, cwd)
+    found: dict[str, Hit] = {}
+    for target in targets:
+        for root, rel, why in protected_hits(target):
+            key = _key(root, rel)
+            if key not in found or (found[key][3] == "names" and target.how == "writes"):
+                found[key] = (root, rel, why, target.how,
+                              rel.endswith("/") or os.path.isdir(os.path.join(root, rel)))
+    ok = approved(session)
+    asked = {key: hit for key, hit in found.items() if not _covered(key, ok)}
+    output: dict[str, object] = {}
+    if asked:
+        output["hookSpecificOutput"] = {"hookEventName": "PreToolUse",
+                                        "permissionDecision": "ask",
+                                        "permissionDecisionReason": _ask_reason(asked)}
+    if call:
+        project = os.environ.get("CLAUDE_PROJECT_DIR")
+        roots = _roots(dirs | {os.path.dirname(t.path) for t in targets}
+                       | ({project} if project else set()))
+        before = {str(r): p for r in roots if (p := fingerprint(r)) is not None}
+        try:                    # the ask above stands whatever the temp store does (SF5)
+            STATE_DIR.mkdir(parents=True, exist_ok=True)
+            _prune(session)
+            _pending_file(session, call).write_text(json.dumps({"asked": sorted(asked),
+                                                                "before": before}))
+        except OSError as exc:
+            output["systemMessage"] = (
+                f"decision-line guard (W77) could not keep its reading of this Bash call ({exc}), "
+                "so the after-check is off for it; an ask still stands, and the commit gate is "
+                "the record (.claude/hooks/decision_path_guard.py).")
+    if output:
+        print(json.dumps(output))
+    return 0
+
+
+def _shown_command(command: str) -> str:
+    """The command for the operator's notice, cut at 200 characters and saying so."""
+    if len(command) <= 200:
+        return f"The command: {command!r}."
+    return f"The command (first 200 of {len(command)} characters): {command[:200]!r}."
+
+
+def _bash_after(session: str, call: str, event: str, command: str) -> int:
+    pending_file = _pending_file(session, call)
+    try:
+        pending = json.loads(pending_file.read_text())
+        pending_file.unlink()
+    except (OSError, ValueError):
+        return 0                                       # no reading from before the call
+    asked = {str(k) for k in pending.get("asked") or []}   # the call ran: each ask was granted
+    ok = approved(session) | asked
+    reported_file = _state_file(session, "-reported")
+    told = _read_set(reported_file)
+    changed: dict[str, tuple[str, str, str]] = {}
+    wrote: dict[str, str] = {}
+    for root_name, before in (pending.get("before") or {}).items():
+        root = Path(root_name)
+        after = fingerprint(root)
+        if after is None:
+            continue
+        moved = sorted(r for r in set(before) | set(after) if before.get(r) != after.get(r))
+        wrote.update({_key(root_name, r): r for r in moved if _covered(_key(root_name, r), asked)})
+        unasked = [r for r in moved if not _covered(_key(root_name, r), ok)
+                   and _key(root_name, r) not in told]
+        for rel in sorted(set(unasked) - known_states(root, unasked, after)):
+            changed[_key(root_name, rel)] = (root_name, rel, protected_reason(rel) or "protected")
+    # A grant covers the session only for the files the call CHANGED (Codex on #1155): a path it
+    # merely named, as inline Python that reads a protected file and writes another does, is
+    # asked about again next time.
+    for key in sorted(wrote):
+        record_approval(session, key)
+    notices: list[str] = []
+    if wrote:                  # the ask may have been answered by a mode, not a person (SF7)
+        names = sorted(wrote.values())
+        notices.append(f"decision-line guard: this Bash call was approved to write a protected "
+                       f"path, and it changed {len(names)} protected file(s) "
