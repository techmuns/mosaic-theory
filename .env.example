# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit `.env`. NEVER paste real keys into chat, commit messages, or logs.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# `vinci` auto-loads this file from the repo root at startup — no manual step needed.
# (For non-vinci tools, load it into your shell with:  set -a; . ./.env; set +a)

# Polygon.io — EOD price feed (step 3). Free tier is personal/eval use only.
POLYGON_API_KEY=replace-with-your-polygon-key

# Anthropic — graph-track LLM extraction (Test 0). Core loop does not use it.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# Optional: SEC fair-access contact (defaults to a generic UA if unset).
SEC_USER_AGENT=Your Name your@email.com
